{
  "name": "kvrocks-repo-gateway",
  "version": "1.0.0",
  "description": "Cloudflare Worker edge gateway for Apache Kvrocks APT & RPM package repository",
  "type": "module",
  "scripts": {
    "build": "node scripts/render.mjs",
    "test": "node --test test/worker.test.js",
    "dev": "node scripts/render.mjs && npx wrangler dev",
