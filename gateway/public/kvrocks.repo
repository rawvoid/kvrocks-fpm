[kvrocks]
name=Apache Kvrocks Repository
baseurl=__REPO_ORIGIN__/rpm/stable/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=__REPO_ORIGIN__/kvrocks.asc

[kvrocks-testing]
name=Apache Kvrocks Testing Repository
baseurl=__REPO_ORIGIN__/rpm/testing/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=__REPO_ORIGIN__/kvrocks.asc
