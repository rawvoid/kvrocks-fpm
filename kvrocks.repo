[kvrocks]
name=Apache Kvrocks Repository
baseurl=kvrocks.kryo.eu.org/rpm/stable/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=kvrocks.kryo.eu.org/kvrocks.asc

[kvrocks-testing]
name=Apache Kvrocks Testing Repository
baseurl=kvrocks.kryo.eu.org/rpm/testing/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=kvrocks.kryo.eu.org/kvrocks.asc
