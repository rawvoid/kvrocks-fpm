/var/log/kvrocks/*.log /var/log/kvrocks/*.log.* {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    olddir archive
    createolddir 0750 kvrocks kvrocks
    su kvrocks kvrocks
    sharedscripts
    postrotate
        find /var/log/kvrocks -maxdepth 1 -name "*.log.*" -type f -size 0 -mmin +60 -delete 2>/dev/null || true
    endscript
}
