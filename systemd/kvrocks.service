[Unit]
Description=Apache Kvrocks SSD key-value database
Documentation=https://kvrocks.apache.org/
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=kvrocks
Group=kvrocks
WorkingDirectory=/var/lib/kvrocks
ExecStart=/usr/bin/kvrocks -c /etc/kvrocks/kvrocks.conf
Restart=on-failure
RestartSec=10s
LimitNOFILE=100000
TasksMax=1024
TimeoutStopSec=300s
StateDirectory=kvrocks
StateDirectoryMode=0750
LogsDirectory=kvrocks
LogsDirectoryMode=0750
NoNewPrivileges=yes
UMask=0027

[Install]
WantedBy=multi-user.target
